---
import Layout from '../../layouts/Layout.astro';
import Fonts from '../../components/Fonts.astro';
import Motion from '../../components/Motion.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import Skills from '../../components/Skills.astro';
import Internships from '../../components/Internships.astro';
import Projects from '../../components/Projects.astro';
import Footer from '../../components/Footer.astro';
---

<Layout>
	<Fonts />
	<Motion />
	<div class="vm min-h-screen bg-(--vm-paper) text-(--vm-ink)">
		<Navbar title="Vicente Muñoz" />
		<main>
			<Hero />
			<Skills />
			<Internships />
			<Projects />
		</main>
		<Footer />
	</div>
</Layout>
