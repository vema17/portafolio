---
import Layout from '../layouts/Layout.astro';
import Fonts from '../components/Fonts.astro';
import Motion from '../components/Motion.astro';

const profiles = [
	{ href: "/ulises", name: "Ulises", role: "Ingeniero en Computación" },
	{ href: "/vicente", name: "Vicente", role: "Ingeniero en Computación" },
	{ href: "/gabriel", name: "Gabriel", role: "Estudiante" },
];
---

<Layout title="Selecciona un perfil" description="Elige el perfil profesional que deseas ver">
	<Fonts />
	<Motion />
	<main class="vm relative overflow-hidden min-h-screen bg-(--vm-paper) text-(--vm-ink) flex items-center">
		<div class="vm-grid" aria-hidden="true"></div>
		<div class="relative max-w-6xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-16 md:py-24">
			<header class="mb-12 md:mb-16">
				<p class="vm-mono text-(--vm-accent) mb-4">Portafolios de UVG</p>
				<h1 class="vm-display text-4xl sm:text-5xl lg:text-6xl leading-tight mb-6" aria-label="Selecciona un perfil" data-type>
					<span data-type-line>Selecciona un perfil</span>
				</h1>
				<p class="text-lg text-(--vm-muted)" data-reveal>
					Explora los portafolios
				</p>
			</header>

			<div class="grid md:grid-cols-3 gap-6">
				{profiles.map((profile, i) => (
					<a
						href={profile.href}
						data-reveal
						style={`--i: ${i + 1}`}
						class="group flex flex-col bg-(--vm-surface) border border-(--vm-line) rounded-2xl p-7 hover:border-(--vm-accent) hover:-translate-y-1 transition duration-200"
					>
						<div class="flex justify-between items-start mb-16">
							<span class="vm-mono text-(--vm-muted)">{String(i + 1).padStart(2, "0")}</span>
							<span class="text-2xl leading-none text-(--vm-muted) group-hover:text-(--vm-accent) group-hover:translate-x-1 transition" aria-hidden="true">→</span>
						</div>
						<h2 class="vm-display text-4xl mb-2">{profile.name}</h2>
						<p class="text-(--vm-muted) mb-8">{profile.role}</p>
						<p class="mt-auto pt-4 border-t border-(--vm-line) vm-mono text-(--vm-muted) group-hover:text-(--vm-accent) transition-colors">
							Ver perfil
						</p>
					</a>
				))}
			</div>
		</div>
	</main>
</Layout>
