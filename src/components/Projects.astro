---
const projects = [
  {
    title: "Sistema de Gestión",
    href: "https://github.com/vema17/ArtPlace",
    host: "github.com/vema17/ArtPlace",
    description: "Aplicación web de comercio electrónico utilizando JavaScript y Python.",
    tags: ["JavaScript", "Python", "Pandas"],
  },
  {
    title: "Sitio Web",
    href: "https://vicente.uvg.cl",
    host: "vicente.uvg.cl",
    description: "Portafolio construido con Astro y Tailwind CSS.",
    tags: ["Astro", "Tailwind"],
  },
  {
    title: "Proyecto Narfu",
    href: "https://narfu.dylan.click/",
    host: "narfu.dylan.click",
    description:
      "Monitoreo para riego tecnificado en página web. Trabajé en la IA, la cual proporciona la cantidad de agua requerida utilizando los datos del huerto y el clima.",
    tags: ["Python", "Machine Learning"],
  },
];
---

<section id="trabajos" class="py-20 md:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <header class="mb-12 md:mb-16" data-reveal>
      <p class="vm-mono text-(--vm-accent) mb-3">03 — Trabajos</p>
      <h2 class="vm-display text-3xl md:text-5xl">Trabajos realizados</h2>
    </header>

    <div class="grid md:grid-cols-3 gap-6">
      {projects.map((project, i) => (
        <a
          href={project.href}
          target="_blank"
          rel="noopener"
          data-reveal
          style={`--i: ${i}`}
          class="group flex flex-col bg-(--vm-surface) border border-(--vm-line) rounded-2xl p-7 hover:border-(--vm-accent) hover:-translate-y-1 transition duration-200"
        >
          <div class="flex justify-between items-start mb-10">
            <span class="vm-mono text-(--vm-muted)">{String(i + 1).padStart(2, "0")}</span>
            <span class="text-2xl leading-none text-(--vm-muted) group-hover:text-(--vm-accent) group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition" aria-hidden="true">↗</span>
          </div>
          <h3 class="vm-display text-2xl mb-3">{project.title}</h3>
          <p class="text-(--vm-muted) leading-relaxed mb-6">{project.description}</p>
          <ul class="flex flex-wrap gap-2 mb-8">
            {project.tags.map((tag) => (
              <li class="vm-mono bg-(--vm-accent-soft) text-(--vm-accent) rounded-full px-3 py-1">{tag}</li>
            ))}
          </ul>
          <p class="mt-auto pt-4 border-t border-(--vm-line) text-sm text-(--vm-muted) group-hover:text-(--vm-accent) transition-colors truncate">
            {project.host}
          </p>
        </a>
      ))}
    </div>
  </div>
</section>
