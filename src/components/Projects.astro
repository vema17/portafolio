---

<section id="trabajos" class="py-16 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-4xl font-bold text-center mb-12 text-gray-900">Trabajos Realizados</h2>
    
    <div class="grid md:grid-cols-3 gap-8">
      <a href="https://github.com/vema17/ArtPlace" target="_blank" rel="noopener" class="bg-gray-50 rounded-lg overflow-hidden shadow-md hover:shadow-xl transition hover:-translate-y-2">
        <div class="h-48 bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center">
          <span class="text-5xl">💻</span>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Sistema de Gestión</h3>
          <p class="text-gray-600 mb-4">
            Aplicación web de comercio electrónico utilizando Javascript y Python.
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="bg-red-100 text-red-800 px-2 py-1 rounded text-xs">JavaScript</span>
            <span class="bg-purple-100 text-purple-800 px-2 py-1 rounded text-xs">Python</span>
            <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs">Pandas</span>
          </div>
          <p class="text-blue-600 font-semibold hover:text-blue-700">Ver más →</p>
        </div>
      </a>

      <a href="https://vicente.uvg.cl" target="_blank" rel="noopener" class="bg-gray-50 rounded-lg overflow-hidden shadow-md hover:shadow-xl transition hover:-translate-y-2">
        <div class="h-48 bg-gradient-to-br from-yellow-400 to-yellow-600 flex items-center justify-center">
          <span class="text-5xl">🌐</span>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Sitio Web</h3>
          <p class="text-gray-600 mb-4">
            Portafolio construido con Astro y Tailwind CSS.
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="bg-yellow-100 text-yellow-800 px-2 py-1 rounded text-xs">Astro</span>
            <span class="bg-cyan-100 text-cyan-800 px-2 py-1 rounded text-xs">Tailwind</span>
          </div>
          <p class="text-blue-600 font-semibold hover:text-blue-700">Ver más →</p>
        </div>
      </a>

      <a href="https://narfu.dylan.click/" target="_blank" rel="noopener" class="bg-gray-50 rounded-lg overflow-hidden shadow-md hover:shadow-xl transition hover:-translate-y-2">
        <div class="h-48 bg-gradient-to-br from-purple-400 to-purple-600 flex items-center justify-center">
          <span class="text-5xl">💧</span>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Proyecto Narfu</h3>
          <p class="text-gray-600 mb-4">
            Monitoreo para riego tecnificado en pagina web.
            Trabajé en la IA la cual proporciona la cantidad de agua requerida utilizando los datos del huerto y el clima.
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs">Python</span>
            <span class="bg-green-100 text-green-800 px-2 py-1 rounded text-xs">Machine Learning</span>
          </div>
          <p class="text-blue-600 font-semibold hover:text-blue-700">Ver más →</p>
        </div>
      </a>
    </div>
  </div>
</section>
