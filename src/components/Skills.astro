---
---

<section id="habilidades" class="py-16 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-4xl font-bold text-center mb-12 text-gray-900">Habilidades Técnicas</h2>
    
    <div class="space-y-12">
      <!-- Lenguajes de Programación -->
      <div>
        <h3 class="text-2xl font-semibold text-blue-600 mb-6 pb-3 border-b-2 border-blue-300">📝 Lenguajes de Programación</h3>
        <div class="grid md:grid-cols-4 gap-4">
          <div class="bg-gradient-to-br from-blue-50 to-blue-100 p-4 rounded-lg border border-blue-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">C</p>
            <p class="text-gray-600 text-sm">Sistemas</p>
          </div>
          <div class="bg-gradient-to-br from-green-50 to-green-100 p-4 rounded-lg border border-green-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">Python</p>
            <p class="text-gray-600 text-sm">Análisis de datos</p>
          </div>
          <div class="bg-gradient-to-br from-red-50 to-red-100 p-4 rounded-lg border border-red-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">Java</p>
            <p class="text-gray-600 text-sm">Aplicaciones</p>
          </div>
          <div class="bg-gradient-to-br from-purple-50 to-purple-100 p-4 rounded-lg border border-purple-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">PHP</p>
            <p class="text-gray-600 text-sm">Backend web</p>
          </div>
          <div class="bg-gradient-to-br from-yellow-50 to-yellow-100 p-4 rounded-lg border border-yellow-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">JavaScript</p>
            <p class="text-gray-600 text-sm">Frontend</p>
          </div>
          <div class="bg-gradient-to-br from-orange-50 to-orange-100 p-4 rounded-lg border border-orange-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">HTML</p>
            <p class="text-gray-600 text-sm">Estructura</p>
          </div>
          <div class="bg-gradient-to-br from-cyan-50 to-cyan-100 p-4 rounded-lg border border-cyan-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">CSS</p>
            <p class="text-gray-600 text-sm">Estilos</p>
          </div>
        </div>
      </div>

      <!-- Frameworks -->
      <div>
        <h3 class="text-2xl font-semibold text-green-600 mb-6 pb-3 border-b-2 border-green-300">🎨 Frameworks y Librerías</h3>
        <div class="grid md:grid-cols-4 gap-4">
          <div class="bg-gradient-to-br from-red-50 to-red-100 p-4 rounded-lg border border-red-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">Laravel</p>
            <p class="text-gray-600 text-sm">Backend PHP</p>
          </div>
          <div class="bg-gradient-to-br from-yellow-50 to-yellow-100 p-4 rounded-lg border border-yellow-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">Express.js</p>
            <p class="text-gray-600 text-sm">Backend Node</p>
          </div>
          <div class="bg-gradient-to-br from-purple-50 to-purple-100 p-4 rounded-lg border border-purple-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">Bootstrap</p>
            <p class="text-gray-600 text-sm">UI Framework</p>
          </div>
          <div class="bg-gradient-to-br from-blue-50 to-blue-100 p-4 rounded-lg border border-blue-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">Tailwind</p>
            <p class="text-gray-600 text-sm">CSS Utility</p>
          </div>
        </div>
      </div>

      <!-- Bases de Datos -->
      <div>
        <h3 class="text-2xl font-semibold text-orange-600 mb-6 pb-3 border-b-2 border-orange-300">🗄️ Bases de Datos</h3>
        <div class="grid md:grid-cols-4 gap-4">
          <div class="bg-gradient-to-br from-blue-50 to-blue-100 p-4 rounded-lg border border-blue-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">MySQL</p>
            <p class="text-gray-600 text-sm">Relacional</p>
          </div>
          <div class="bg-gradient-to-br from-indigo-50 to-indigo-100 p-4 rounded-lg border border-indigo-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">PostgreSQL</p>
            <p class="text-gray-600 text-sm">Relacional</p>
          </div>
          <div class="bg-gradient-to-br from-green-50 to-green-100 p-4 rounded-lg border border-green-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">MongoDB</p>
            <p class="text-gray-600 text-sm">NoSQL</p>
          </div>
          <div class="bg-gradient-to-br from-red-50 to-red-100 p-4 rounded-lg border border-red-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">SQL Server</p>
            <p class="text-gray-600 text-sm">Enterprise</p>
          </div>
        </div>
      </div>

      <!-- Herramientas -->
      <div>
        <h3 class="text-2xl font-semibold text-purple-600 mb-6 pb-3 border-b-2 border-purple-300">🛠️ Herramientas</h3>
        <div class="grid md:grid-cols-5 gap-4">
          <div class="bg-gradient-to-br from-gray-50 to-gray-100 p-4 rounded-lg border border-gray-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">Github</p>
            <p class="text-gray-600 text-sm">Control de versiones</p>
          </div>
          <div class="bg-gradient-to-br from-blue-50 to-blue-100 p-4 rounded-lg border border-blue-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">Jira</p>
            <p class="text-gray-600 text-sm">Gestión de proyectos</p>
          </div>
          <div class="bg-gradient-to-br from-cyan-50 to-cyan-100 p-4 rounded-lg border border-cyan-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">Docker</p>
            <p class="text-gray-600 text-sm">Contenedores</p>
          </div>
          <div class="bg-gradient-to-br from-orange-50 to-orange-100 p-4 rounded-lg border border-orange-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">Postman</p>
            <p class="text-gray-600 text-sm">API Testing</p>
          </div>
          <div class="bg-gradient-to-br from-red-50 to-red-100 p-4 rounded-lg border border-red-200 hover:shadow-md transition">
            <p class="font-semibold text-gray-900">Trello</p>
            <p class="text-gray-600 text-sm">Organización</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
