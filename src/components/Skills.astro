---
const groups = [
  {
    title: "Lenguajes de programación",
    items: [
      { name: "C", detail: "Sistemas" },
      { name: "Python", detail: "Análisis de datos" },
      { name: "Java", detail: "Aplicaciones" },
      { name: "PHP", detail: "Backend web" },
      { name: "JavaScript", detail: "Frontend" },
      { name: "HTML", detail: "Estructura" },
      { name: "CSS", detail: "Estilos" },
    ],
  },
  {
    title: "Frameworks y librerías",
    items: [
      { name: "Laravel", detail: "Backend PHP" },
      { name: "Express.js", detail: "Backend Node" },
      { name: "Bootstrap", detail: "UI Framework" },
      { name: "Tailwind", detail: "CSS Utility" },
    ],
  },
  {
    title: "Bases de datos",
    items: [
      { name: "MySQL", detail: "Relacional" },
      { name: "PostgreSQL", detail: "Relacional" },
      { name: "MongoDB", detail: "NoSQL" },
      { name: "SQL Server", detail: "Enterprise" },
    ],
  },
  {
    title: "Herramientas",
    items: [
      { name: "GitHub", detail: "Control de versiones" },
      { name: "Jira", detail: "Gestión de proyectos" },
      { name: "Docker", detail: "Contenedores" },
      { name: "Postman", detail: "API Testing" },
      { name: "Trello", detail: "Organización" },
    ],
  },
];
---

<section id="habilidades" class="py-20 md:py-28 border-b border-(--vm-line)">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <header class="mb-12 md:mb-16" data-reveal>
      <p class="vm-mono text-(--vm-accent) mb-3">01 — Habilidades</p>
      <h2 class="vm-display text-3xl md:text-5xl">Habilidades técnicas</h2>
    </header>

    <div>
      {groups.map((group) => (
        <div class="grid md:grid-cols-12 gap-x-8 gap-y-4 py-8 border-t border-(--vm-ink)" data-reveal>
          <h3 class="md:col-span-3 text-lg font-semibold">{group.title}</h3>
          <ul class="md:col-span-9 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-8">
            {group.items.map((item) => (
              <li class="py-3 border-b border-(--vm-line)">
                <p class="font-medium">{item.name}</p>
                <p class="text-sm text-(--vm-muted)">{item.detail}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
