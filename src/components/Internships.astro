---
const internships = [
  {
    period: "Enero – Febrero 2026",
    place: "Corte de Apelaciones de La Serena",
    role: "Practicante de desarrollo",
    description:
      "Desarrollando intranet de la corte utilizando PHP Laravel. También realizando soporte técnico y mantenimiento de sistemas internos.",
    tags: ["PHP", "Laravel", "Git"],
  },
  {
    period: "Enero – Febrero 2024",
    place: "Corporación Administrativa del Poder Judicial",
    role: "Practicante de desarrollo",
    description:
      "Participé en el desarrollo de página de asistencia utilizando PHP Laravel. Realicé tareas de soporte técnico y mantenimiento de sistemas internos. Aprendí sobre buenas prácticas de programación, control de versiones y trabajo en equipo.",
    tags: ["PHP", "Laravel", "Git"],
  },
];
---

<section id="practicas" class="py-20 md:py-28 border-b border-(--vm-line) bg-(--vm-surface)">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <header class="mb-12 md:mb-16" data-reveal>
      <p class="vm-mono text-(--vm-accent) mb-3">02 — Prácticas</p>
      <h2 class="vm-display text-3xl md:text-5xl">Prácticas profesionales</h2>
    </header>

    <ol>
      {internships.map((item) => (
        <li class="grid md:grid-cols-12 gap-x-8 gap-y-3 py-10 border-t border-(--vm-ink)" data-reveal>
          <p class="md:col-span-3 vm-mono text-(--vm-muted) pt-2">{item.period}</p>
          <div class="md:col-span-9">
            <h3 class="vm-display text-2xl md:text-3xl leading-tight mb-2">{item.place}</h3>
            <p class="text-(--vm-accent) font-medium mb-4">{item.role}</p>
            <p class="text-(--vm-muted) leading-relaxed max-w-2xl mb-5">{item.description}</p>
            <ul class="flex flex-wrap gap-2">
              {item.tags.map((tag) => (
                <li class="vm-mono border border-(--vm-line) rounded-full px-3 py-1">{tag}</li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
