---
const email = "vicentealtamirano2104@gmail.com";
---

<footer id="contacto" class="bg-(--vm-ink) text-(--vm-paper)">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 md:pt-28 pb-10">
    <p class="vm-mono opacity-60 mb-4">Contacto</p>
    <a
      href={`mailto:${email}`}
      class="vm-display block text-lg sm:text-3xl md:text-4xl lg:text-5xl leading-tight break-all hover:opacity-70 transition-opacity"
    >
      {email}
    </a>

    <div class="grid sm:grid-cols-3 gap-8 mt-16 pt-8 border-t border-(--vm-paper)/20">
      <div>
        <h3 class="font-semibold mb-1">Vicente Muñoz</h3>
        <p class="opacity-60">Ingeniero en Computación</p>
        <p class="opacity-60">La Serena, Chile</p>
      </div>

      <ul class="space-y-2">
        <li><a href="#inicio" class="opacity-60 hover:opacity-100 transition-opacity">Inicio</a></li>
        <li><a href="#habilidades" class="opacity-60 hover:opacity-100 transition-opacity">Habilidades</a></li>
        <li><a href="#practicas" class="opacity-60 hover:opacity-100 transition-opacity">Prácticas</a></li>
        <li><a href="#trabajos" class="opacity-60 hover:opacity-100 transition-opacity">Trabajos</a></li>
      </ul>

      <ul class="space-y-2">
        <li>
          <a href="https://github.com/vema17" target="_blank" rel="noopener" class="opacity-60 hover:opacity-100 transition-opacity">
            GitHub ↗
          </a>
        </li>
        <li>
          <a href="https://www.linkedin.com/in/vicente-munoz-altamirano/" target="_blank" rel="noopener" class="opacity-60 hover:opacity-100 transition-opacity">
            LinkedIn ↗
          </a>
        </li>
      </ul>
    </div>

    <div class="flex flex-col sm:flex-row justify-between gap-2 mt-12 vm-mono opacity-50">
      <p>&copy; 2026 Vicente Muñoz</p>
      <p>Astro + Tailwind CSS</p>
    </div>
  </div>
</footer>
