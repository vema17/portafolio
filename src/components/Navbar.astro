---
interface Props {
  title?: string;
}

const { title = "Vicente Muñoz" } = Astro.props;
---

<nav class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex-shrink-0">
        <a href="#inicio" class="text-2xl font-bold text-blue-600 hover:text-blue-700 transition">
          {title}
        </a>
      </div>
      <div class="hidden md:flex space-x-8">
        <a href="#inicio" class="text-gray-600 hover:text-blue-600 transition font-medium">
          Inicio
        </a>
        <a href="#habilidades" class="text-gray-600 hover:text-blue-600 transition font-medium">
          Habilidades
        </a>
        <a href="#practicas" class="text-gray-600 hover:text-blue-600 transition font-medium">
          Prácticas
        </a>
        <a href="#trabajos" class="text-gray-600 hover:text-blue-600 transition font-medium">
          Trabajos
        </a>
      </div>
    </div>
  </div>
</nav>
