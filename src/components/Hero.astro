---
const email = "vicentealtamirano2104@gmail.com";

const facts = [
  { label: "Título", value: "Ingeniero en Computación" },
  { label: "Universidad", value: "Universidad de La Serena" },
  { label: "Ubicación", value: "La Serena, Chile" },
  { label: "Intereses", value: "Análisis de datos · Desarrollo web" },
];
---

<section id="inicio" class="relative overflow-hidden border-b border-(--vm-line)">
  <div class="vm-grid" aria-hidden="true"></div>
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-28">
    <div class="grid md:grid-cols-12 gap-12 md:gap-8 items-end">
      <div class="md:col-span-7">
        <p class="vm-mono inline-flex items-center gap-2 text-(--vm-muted) mb-8">
          <span class="w-2 h-2 rounded-full bg-(--vm-muted)"></span>
          No disponible
        </p>
        <h1 class="vm-display text-6xl sm:text-7xl lg:text-8xl leading-none mb-8" aria-label="Vicente Muñoz" data-type>
          <span class="block" data-type-line>Vicente</span>
          <span class="block" data-type-line>Muñoz</span>
        </h1>
        <h2 class="text-xl md:text-2xl text-(--vm-accent) font-medium mb-5" data-reveal>
          Ingeniero en Computación
        </h2>
        <p class="text-(--vm-muted) leading-relaxed max-w-xl mb-10" data-reveal style="--i: 1">
          Titulado de la Universidad de La Serena. Desarrollador interesado en el análisis de datos y el desarrollo web. En búsqueda de oportunidades para aplicar mis habilidades y seguir creciendo profesionalmente.
        </p>
        <div class="flex flex-wrap gap-3" data-reveal style="--i: 2">
          <a
            href="#trabajos"
            class="bg-(--vm-ink) text-(--vm-paper) px-6 py-3 rounded-full font-medium hover:bg-(--vm-accent) transition-colors"
          >
            Ver trabajos
          </a>
          <a
            href="#practicas"
            class="border border-(--vm-ink) px-6 py-3 rounded-full font-medium hover:border-(--vm-accent) hover:text-(--vm-accent) transition-colors"
          >
            Ver prácticas
          </a>
        </div>
      </div>

      <aside class="md:col-span-5 lg:col-span-4 lg:col-start-9" data-reveal style="--i: 3">
        <dl class="border-t border-(--vm-ink)">
          {facts.map((fact) => (
            <div class="flex justify-between gap-6 py-3 border-b border-(--vm-line)">
              <dt class="vm-mono text-(--vm-muted) pt-0.5">{fact.label}</dt>
              <dd class="text-right text-sm font-medium">{fact.value}</dd>
            </div>
          ))}
          <div class="flex justify-between gap-6 py-3 border-b border-(--vm-line)">
            <dt class="vm-mono text-(--vm-muted) pt-0.5">Correo</dt>
            <dd class="text-right text-sm font-medium min-w-0">
              <a href={`mailto:${email}`} class="text-(--vm-accent) hover:underline underline-offset-4 break-all">
                {email}
              </a>
            </dd>
          </div>
        </dl>
      </aside>
    </div>
  </div>
</section>
